{
  "env": {
    "LIVE_CHECKOUT": "/path/to/the/checkout/your/service/runs/from",
    "LANE_LEDGER": ".loop/lanes.json"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/git_rules.py"},
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/kill_rules.py"},
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/waiter_guard.py"},
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/live_checkout.py"}
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/live_checkout.py"}
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/admission_gate.py"}
        ]
      }
    ]
  }
}
